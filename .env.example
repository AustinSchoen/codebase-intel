# Codebase Intelligence — environment variables
#
# Copy to .env and fill in. `./setup.sh` will create this file for you
# and auto-generate the *_KEY values; this template is for reference and
# for manual / non-Docker setups.

# Required: Voyage AI key for code embeddings.
# Get one at https://dash.voyageai.com/api-keys
VOYAGE_API_KEY=

# Auto-generated by setup.sh. Used by both Qdrant and the server.
QDRANT_API_KEY=

# Postgres credentials. CI_PG_USER defaults to "codebase_intel".
CI_PG_USER=codebase_intel
CI_PG_PASSWORD=

# Bearer token for the MCP HTTP API. Auto-generated by setup.sh.
# Pass as `Authorization: Bearer $MCP_API_KEY` when calling /mcp.
MCP_API_KEY=

# Optional: enables architectural summaries via Claude
# (`summaries.enabled: true` in the codebase config).
ANTHROPIC_API_KEY=
